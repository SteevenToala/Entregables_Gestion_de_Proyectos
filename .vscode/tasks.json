{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compilar PDF actual (pdflatex)",
      "type": "shell",
      "command": "pdflatex -interaction=nonstopmode -synctex=1 ${fileBasename}",
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$latex"]
    },
    {
      "label": "Compilar TODOS los PDFs del proyecto",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File ./compile_all.ps1",
      "group": "build",
      "problemMatcher": []
    }
  ]
}
